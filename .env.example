# ==============================================================================
# NPC-402 & OMNIVOICE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Web Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. DATABASE & SUPABASE (PostgreSQL, Storage, RLS)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string or Supabase Transaction Pooler URL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION (User Management, Sessions, SSR)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ------------------------------------------------------------------------------
# 3. AI & LLM PROVIDERS (Dialogue Generation & RAG)
# ------------------------------------------------------------------------------
# Google Gemini (Primary high-speed LLM)
GEMINI_API_KEY=
# OpenAI (Fallback dialogue & text-embedding-3-small)
OPENAI_API_KEY=
# NVIDIA NIM Inference (Llama-3.1 / Nemotron)
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ------------------------------------------------------------------------------
# 4. PINECONE VECTOR DATABASE (Knowledge Lore & RAG)
# ------------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=npc-knowledge
PINECONE_ENVIRONMENT=us-east-1

# ------------------------------------------------------------------------------
# 5. OMNIVOICE & NEURAL VOICE PROVIDERS
# ------------------------------------------------------------------------------
# Local OmniVoice Studio Python Backend URL (optional, defaults to local port 8000)
OMNIVOICE_URL=http://127.0.0.1:8000
# Cartesia Sonic TTS API Key (optional cloud vocoder fallback)
CARTESIA_API_KEY=

# ------------------------------------------------------------------------------
# 6. WEB3 & x402 MICROPAYMENTS (Wagmi, Viem, Base Sepolia)
# ------------------------------------------------------------------------------
MERCHANT_ADDRESS=0x9876543210FEDCBA9876543210FEDCBA98765432
CHAIN_ID=84532
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ------------------------------------------------------------------------------
# 7. EMAIL (Resend Transactional Emails)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY & MONITORING (PostHog & Sentry)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# ------------------------------------------------------------------------------
# 9. CLOUDFLARE TURNSTILE (Bot Guard & Captcha)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...
